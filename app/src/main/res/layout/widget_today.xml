<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_today_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/instrument_sans"
            android:letterSpacing="0.16"
            android:text="EVEXIA · TODAY"
            android:textColor="@color/widget_accent"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/instrument_sans"
            android:text="SCHEDULE"
            android:textColor="@color/widget_muted"
            android:textSize="9sp"
            android:letterSpacing="0.1" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:fontFamily="@font/instrument_serif"
        android:maxLines="1"
        android:text="Friday, 22 October"
        android:textColor="@color/widget_text"
        android:textSize="23sp" />

    <TextView
        android:id="@+id/widget_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:fontFamily="@font/instrument_sans"
        android:maxLines="2"
        android:text="09:00  Linear Algebra  ·  Hall B"
        android:textColor="@color/widget_text"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:fontFamily="@font/instrument_sans"
        android:maxLines="2"
        android:textColor="@color/widget_text"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:fontFamily="@font/instrument_sans"
        android:maxLines="2"
        android:textColor="@color/widget_text"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/instrument_sans"
        android:text="Tap to open timetable  →"
        android:textColor="@color/widget_muted"
        android:textSize="9sp" />
</LinearLayout>
